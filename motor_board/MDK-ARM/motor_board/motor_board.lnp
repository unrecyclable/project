--cpu Cortex-M3
"motor_board\startup_stm32f103xb.o"
"motor_board\main.o"
"motor_board\gpio.o"
"motor_board\dma.o"
"motor_board\i2c.o"
"motor_board\tim.o"
"motor_board\usart.o"
"motor_board\stm32f1xx_it.o"
"motor_board\stm32f1xx_hal_msp.o"
"motor_board\stm32f1xx_hal_gpio_ex.o"
"motor_board\stm32f1xx_hal_i2c.o"
"motor_board\stm32f1xx_hal.o"
"motor_board\stm32f1xx_hal_rcc.o"
"motor_board\stm32f1xx_hal_rcc_ex.o"
"motor_board\stm32f1xx_hal_gpio.o"
"motor_board\stm32f1xx_hal_dma.o"
"motor_board\stm32f1xx_hal_cortex.o"
"motor_board\stm32f1xx_hal_pwr.o"
"motor_board\stm32f1xx_hal_flash.o"
"motor_board\stm32f1xx_hal_flash_ex.o"
"motor_board\stm32f1xx_hal_exti.o"
"motor_board\stm32f1xx_hal_tim.o"
"motor_board\stm32f1xx_hal_tim_ex.o"
"motor_board\stm32f1xx_hal_uart.o"
"motor_board\system_stm32f1xx.o"
"motor_board\pwm.o"
"motor_board\serial.o"
--strict --scatter "motor_board\motor_board.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "motor_board.map" -o motor_board\motor_board.axf